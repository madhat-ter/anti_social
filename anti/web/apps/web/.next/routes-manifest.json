{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anti-social-opal.vercel.app"
        }
      ],
      "destination": "https://tryanti.social/:path*",
      "statusCode": 307,
      "regex": "^(?!/_next)(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/events/new",
      "destination": "/collab/new?kind=event",
      "statusCode": 308,
      "regex": "^(?!/_next)/events/new(?:/)?$"
    },
    {
      "source": "/events/:id/edit",
      "destination": "/collab/event/:id/edit",
      "statusCode": 308,
      "regex": "^(?!/_next)/events(?:/([^/]+?))/edit(?:/)?$"
    },
    {
      "source": "/events/:id",
      "destination": "/collab/event/:id",
      "statusCode": 308,
      "regex": "^(?!/_next)/events(?:/([^/]+?))(?:/)?$"
    },
    {
      "source": "/events",
      "destination": "/collab?kind=event",
      "statusCode": 308,
      "regex": "^(?!/_next)/events(?:/)?$"
    },
    {
      "source": "/collabs/new",
      "destination": "/collab/new",
      "statusCode": 308,
      "regex": "^(?!/_next)/collabs/new(?:/)?$"
    },
    {
      "source": "/collabs/:id/edit",
      "destination": "/collab/:id/edit",
      "statusCode": 308,
      "regex": "^(?!/_next)/collabs(?:/([^/]+?))/edit(?:/)?$"
    },
    {
      "source": "/collabs/:id",
      "destination": "/collab/:id",
      "statusCode": 308,
      "regex": "^(?!/_next)/collabs(?:/([^/]+?))(?:/)?$"
    },
    {
      "source": "/collabs",
      "destination": "/collab",
      "statusCode": 308,
      "regex": "^(?!/_next)/collabs(?:/)?$"
    },
    {
      "source": "/search",
      "destination": "/members",
      "statusCode": 308,
      "regex": "^(?!/_next)/search(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=()"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/:path*",
        "destination": "https://tryanti.social/api/:path*",
        "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/collab/event/[id]",
      "regex": "^/collab/event/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
