# Postgres. The default is the zero-install dev database that `bun run dev` starts
# (PGlite served on :5432, data in ./.pglite). For real Postgres / docker compose use:
#   DATABASE_URL=postgres://anti:anti@localhost:5432/anti
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# PGlite is single-connection underneath: keep the pool at 1 for it. Remove (default 10) for real Postgres.
DATABASE_POOL_MAX=1

# API
API_PORT=3001
# WebAuthn relying party. RP_ID must be the bare domain of the web app (no scheme/port).
# It cannot change after launch without every user re-registering their passkey.
RP_ID=localhost
RP_NAME=Anti
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Web
API_URL=http://localhost:3001

# Uploaded media (local disk). Default: <repo>/.uploads. Relative paths resolve against the repo root.
# UPLOAD_DIR=.uploads
# STORAGE=db keeps images in Postgres instead (hosts without a disk, e.g. Render's free plan).
# STORAGE=disk

# Apply migrations when the API starts (hosts where nobody runs `bun run db:migrate`).
# MIGRATE_ON_BOOT=true

# Payments. Without STRIPE_SECRET_KEY the API uses a built-in fake Stripe: checkout opens a local
# test page (/dev/checkout) and paying there runs the real webhook code path. Refused in production
# unless ALLOW_FAKE_PAYMENTS=true (free test deploys only, see docs/deploy-free.md).
# PAYMENTS=fake
# For real Stripe (test mode keys work): PAYMENTS=stripe plus both keys below.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (from: stripe listen --forward-to localhost:3001/webhooks/stripe)

# Behind a reverse proxy (Fly, etc.): take the client IP for rate limits from its header.
# TRUST_PROXY=true

# Web Push. Generate once with: bun run ops:vapid-keys   (without these, push is off)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
