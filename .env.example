# Postgres. The default is the zero-install dev database that `bun run dev` starts
# (PGlite served on :5432, data in ./.pglite). For real Postgres / docker compose use:
#   DATABASE_URL=postgres://anti:anti@localhost:5432/anti
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# PGlite is single-connection underneath: keep the pool at 1 for it. Remove (default 10) for real Postgres.
DATABASE_POOL_MAX=1

# API
API_PORT=3001
# WebAuthn relying party. RP_ID must be the bare domain of the web app (no scheme/port).
# It cannot change after launch without every user re-registering their passkey.
RP_ID=localhost
RP_NAME=Anti
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Web
API_URL=http://localhost:3001

# Uploaded media (local disk). Default: <repo>/.uploads. Relative paths resolve against the repo root.
# UPLOAD_DIR=.uploads
